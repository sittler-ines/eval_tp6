# Base de données
SQLITE_DB_PATH=./data/clients.db

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=VOTRE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=VOTRE_CLIENT_SECRET
# Local : http://localhost:4321/api/auth/callback
# VPS   : https://clients.<votredomaine>.<tld>/api/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/callback

# Secret de signature des cookies (générer avec : openssl rand -base64 32)
AUTH_SECRET=

# Optionnel : emails autorisés, séparés par des virgules (vide = tout compte Google)
ALLOWED_EMAILS=
