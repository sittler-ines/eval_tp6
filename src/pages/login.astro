---
if (Astro.locals.user) {
  return Astro.redirect("/");
}

const errors = {
  state: "La session de connexion a expiré, veuillez réessayer.",
  google: "La connexion avec Google a échoué.",
  forbidden: "Ce compte Google n'est pas autorisé à accéder à l'application."
};

const error = errors[Astro.url.searchParams.get("error")];
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Connexion | Clients</title>

  <style>
    :root {
      --background: #f5f7fb;
      --card: #ffffff;
      --text: #172033;
      --muted: #718096;
      --border: #e7ebf2;
      --primary: #4f46e5;
      --danger: #dc2626;
      --shadow: 0 8px 30px rgba(15, 23, 42, 0.07);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;

      display: grid;
      place-items: center;

      padding: 16px;

      background: var(--background);
      color: var(--text);
      font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    }

    .login-card {
      width: 100%;
      max-width: 400px;

      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);

      padding: 36px 32px;
      text-align: center;
    }

    .brand-icon {
      width: 56px;
      height: 56px;
      margin: 0 auto 18px;
      border-radius: 16px;

      display: grid;
      place-items: center;

      background: var(--primary);
      font-size: 26px;
    }

    h1 {
      margin: 0;
      font-size: 22px;
      letter-spacing: -0.4px;
    }

    p {
      margin: 8px 0 26px;
      color: var(--muted);
      font-size: 14px;
    }

    .error {
      margin: 0 0 20px;
      padding: 10px 12px;

      background: #fef2f2;
      color: var(--danger);
      border-radius: 10px;

      font-size: 13px;
    }

    .google-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;

      width: 100%;
      padding: 12px 16px;

      border: 1px solid var(--border);
      border-radius: 12px;
      background: white;
      color: var(--text);

      font-size: 14px;
      font-weight: 600;
      text-decoration: none;

      transition: 0.2s;
    }

    .google-button:hover {
      background: #f8fafc;
      border-color: #d5dae3;
    }
  </style>
</head>

<body>

  <main class="login-card">

    <div class="brand-icon">📍</div>

    <h1>Clients</h1>

    <p>Connectez-vous pour accéder au tableau de bord.</p>

    {error && <div class="error">{error}</div>}

    <a class="google-button" href="/api/auth/login">
      <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
        <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
        <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
      </svg>
      Se connecter avec Google
    </a>

  </main>

</body>
</html>
